EMAIL_FROM=
EMAIL_TO=
EMAIL_PASSWORD=

# Optional settings (defaults shown)
HEADLESS=true
LOG_LEVEL=INFO

# Firestore project. In Cloud Run this is normally auto-detected from
# GOOGLE_CLOUD_PROJECT, so you usually only need to set this for local runs
# against the Firestore emulator (any non-empty value works, e.g. demo-test).
FIRESTORE_PROJECT_ID=
# Only needed if you use a named Firestore database instead of "(default)".
FIRESTORE_DATABASE_ID=

# For local development against the Firestore emulator, also export:
#   FIRESTORE_EMULATOR_HOST=localhost:8080
# (not read by this app directly -- it is read by the google-cloud-firestore
# client library itself, so set it in your shell before running.)
